# Optional ServiceNow instance overrides
SN_GSCTEST_BASE_URL=https://sn-gsctest.churchofjesuschrist.org
SN_GSCDEV_BASE_URL=https://sn-gscdev.churchofjesuschrist.org

# Optional record URL overrides for the CSAS sidebar regression test.
# When omitted, the test selects the newest active record of each case type.
SN_GSCTEST_CSLUS_CASE_URL=https://your-gsctest-instance/now/cwf/agent/record/your-cslus-table/your-record-sys-id
SN_GSCTEST_CSAS_CASE_URL=https://your-gsctest-instance/now/cwf/agent/record/your-csas-table/your-record-sys-id

# Required when using the Genesys helpers
SN_GSCDEV_IN_APP_CASE_URL=https://your-in-app-server/testCaseUi
SN_GSCDEV_OPEN_CASES_LIST_URL=https://your-gscdev-instance/now/cwf/agent/list/your-open-cases-list

# Optional saved-session locations
SN_GSCTEST_STORAGE_STATE=playwright/.auth/gsctest-state.json
SN_GSCDEV_STORAGE_STATE=playwright/.auth/gscdev-state.json

# Required only to intentionally run a GSCTEST test that creates or updates records.
# Set this in your terminal or WebStorm run configuration; do not commit it in a real .env file.
# CONFIRM_GSCTEST_WRITES=GSCTEST
